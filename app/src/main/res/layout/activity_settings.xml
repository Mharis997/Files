<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E0F12"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout style="@style/Header">
        <ImageButton android:id="@+id/back" style="@style/BackButton" />
        <TextView style="@style/HeaderTitle" android:text="Settings" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView style="@style/Section" android:text="VIDEO" />

            <TextView style="@style/Label" android:text="Quality" />
            <LinearLayout style="@style/SegGroup">
                <TextView android:id="@+id/q1080" style="@style/Seg" android:text="1080p" />
                <TextView android:id="@+id/q4k" style="@style/Seg" android:text="4K" />
            </LinearLayout>
            <TextView android:id="@+id/qualityNote" style="@style/Note" />

            <TextView style="@style/Label" android:text="Frame rate" />
            <LinearLayout style="@style/SegGroup">
                <TextView android:id="@+id/fps24" style="@style/Seg" android:text="24 fps" />
                <TextView android:id="@+id/fps30" style="@style/Seg" android:text="30 fps" />
                <TextView android:id="@+id/fps60" style="@style/Seg" android:text="60 fps" />
            </LinearLayout>
            <TextView style="@style/Note" android:text="4K records at 24 or 30 fps. If the camera can't do a frame rate, DualFrame uses 30 fps and tells you." />

            <TextView
                android:id="@+id/size"
                style="@style/Label"
                android:layout_marginTop="16dp"
                android:textColor="#FFFFD60A"
                android:textSize="14sp" />

            <TextView style="@style/Section" android:text="CAMERA" />

            <Switch
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Grid lines"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <TextView style="@style/Section" android:text="STORAGE" />
            <TextView
                style="@style/Note"
                android:text="Each take saves two files: a 9:16 portrait file and a 16:9 landscape file, both MP4 (H.264 + AAC) or JPEG.\n\nVideos: Movies/DualFrame\nPhotos: Pictures/DualFrame" />

            <TextView
                android:id="@+id/version"
                style="@style/Note"
                android:layout_marginTop="32dp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
