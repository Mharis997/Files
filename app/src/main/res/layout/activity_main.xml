<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false">

    <!-- Height set in code to the camera's upright aspect: the full view, with both frames drawn over it. -->
    <FrameLayout
        android:id="@+id/previewBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top"
        android:layout_marginTop="@dimen/top_bar">

        <SurfaceView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.dualframe.recorder.FrameOverlay
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.dualframe.recorder.LineSlider
            android:id="@+id/landscapeSlider"
            android:layout_width="40dp"
            android:layout_height="240dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="Moves the landscape frame" />

        <!-- Portrait frame controls; the whole group turns with the phone. Sliders move along one direction only. -->
        <LinearLayout
            android:id="@+id/joyCluster"
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginHorizontal="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="144dp"
                android:layout_height="112dp"
                android:orientation="horizontal">

                <com.dualframe.recorder.Joystick
                    android:id="@+id/joystick"
                    android:layout_width="112dp"
                    android:layout_height="112dp" />

                <com.dualframe.recorder.LineSlider
                    android:id="@+id/portraitV"
                    android:layout_width="32dp"
                    android:layout_height="112dp"
                    android:contentDescription="Moves the portrait frame up or down" />
            </LinearLayout>

            <com.dualframe.recorder.LineSlider
                android:id="@+id/portraitH"
                android:layout_width="112dp"
                android:layout_height="32dp"
                android:contentDescription="Moves the portrait frame left or right" />
        </LinearLayout>
    </FrameLayout>

    <!-- Top: quick settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/flash"
                style="@style/RoundIcon"
                android:contentDescription="Flash"
                android:src="@drawable/ic_flash_off" />

            <SeekBar
                android:id="@+id/seekFlash"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:contentDescription="Flash brightness"
                android:visibility="invisible" />

            <Chronometer
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:textColor="#FFFF4D4D"
                android:textSize="18sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/fps"
                style="@style/Chip"
                android:background="@drawable/pill"
                android:contentDescription="Frame rate"
                android:text="30 FPS" />
        </LinearLayout>

        <TextView
            android:id="@+id/notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/pill"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="#FFFFD166"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/infoPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="@dimen/top_bar"
        android:layout_marginBottom="200dp"
        android:background="#D9101418"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/infoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#E6FFFFFF"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>

    <!-- Bottom: camera controls -->
    <LinearLayout
        android:id="@+id/cameraControls"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/lenses"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill"
            android:padding="3dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/pill"
            android:clipChildren="false"
            android:padding="3dp">

            <TextView android:id="@+id/modePhoto" style="@style/Chip" android:text="PHOTO" />
            <TextView android:id="@+id/modeVideo" style="@style/Chip" android:text="VIDEO" />
        </LinearLayout>

        <LinearLayout style="@style/ShutterRow" android:clipChildren="false">
            <ImageButton android:id="@+id/info" style="@style/RoundIcon" android:contentDescription="Camera capabilities" android:src="@drawable/ic_info" />
            <FrameLayout android:id="@+id/shutter" style="@style/Shutter" android:contentDescription="Record">
                <View android:id="@+id/shutterInner" style="@style/ShutterInner" />
            </FrameLayout>
            <ImageButton android:id="@+id/flip" style="@style/RoundIcon" android:contentDescription="Switch front or back camera" android:src="@drawable/ic_flip" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
