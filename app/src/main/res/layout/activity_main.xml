<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- The portrait (9:16) file, full width. Height set in code. -->
    <FrameLayout
        android:id="@+id/previewBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top">

        <SurfaceView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Camera view. Tap to focus, pinch to zoom." />

        <com.dualframe.recorder.GridOverlay
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Live view of the landscape (16:9) file, full width. Drag it up or down, edge to edge,
         to choose which part of the scene the landscape file records. Height set in code. -->
    <FrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="top"
        android:contentDescription="Landscape view. Drag up or down to move the landscape frame."
        android:foreground="@drawable/card_border">

        <TextureView
            android:id="@+id/cardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            style="@style/Tag"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:text="16:9" />

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/grip" />
    </FrameLayout>

    <View
        android:id="@+id/focusRing"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/focus_ring"
        android:visibility="invisible" />

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/flash"
            style="@style/RoundIcon"
            android:contentDescription="Turn light on"
            android:src="@drawable/ic_flash_off" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/recPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp">

                <View
                    android:id="@+id/recDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/dot"
                    android:visibility="gone" />

                <Chronometer
                    android:id="@+id/timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="00:00:00"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/quality"
                style="@style/Tag"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/settings"
            style="@style/RoundIcon"
            android:contentDescription="Settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <TextView
        android:id="@+id/notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/tag"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/lenses"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tag"
            android:padding="3dp" />

        <FrameLayout
            android:id="@+id/shutter"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:contentDescription="Record"
            android:focusable="true"
            android:foreground="@drawable/shutter_ring">

            <View
                android:id="@+id/shutterInner"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp">

            <ImageView
                android:id="@+id/gallery"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="#33FFFFFF"
                android:contentDescription="Open captures"
                android:scaleType="center"
                android:src="@drawable/ic_gallery" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:layout_weight="1"
                android:background="@drawable/seg_group"
                android:padding="4dp">

                <TextView android:id="@+id/modeVideo" style="@style/Mode" android:text="VIDEO" />
                <TextView android:id="@+id/modePhoto" style="@style/Mode" android:text="PHOTO" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/flip"
                style="@style/RoundIcon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="Switch front or back camera"
                android:src="@drawable/ic_flip" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
